#set($sdFileName = ${sd.getName().replace(" ","").replace(".","")})
#set($ctryFileName = ${sd.getCountry().replace(" ","").replace(".","")})
#set($cbtorFileName = ${sd.getGroup().replace(" ","").replace(".","")})
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="keywords" content=""/>
        <meta name="description" content=""/>
        <meta name="author" content=""/>
        <title>Lev's Snowdomes</title>
        <link rel="stylesheet" type="text/css" href="style.css"/>
    </head>
    <body class="singleLeftPane">
        <div id="pageWrapper">
            <div id="pageHeader">
                <h1>
                    <strong>
                        <font size="5">My Snowdome Collection</font>
                    </strong>
                    <br>
                </h1>
            </div>
            <div id="subPageWrapper">
                <div id="siteNavigation">
                    <h1>Navigation</h1>
                    <ul>
                        <li>
                            <a href="${index}.html">Home</a>
                            <a href="${news}.html">Latest</a>
                            <a href="${all}.html">All</a>
                            <a href="${ctts}.html">By country</a>
                            <a href="${cbtors}.html">By contributor</a>
                            <a href="${nc}.html">Non-classified</a>
                            <a href="${bl}.html">Blacklist</a>
                        </li>
                    </ul>
                    <div id="listBreaker"></div>
                </div>
                <div id="extraContent">
                    <div class="contentContainer">
                        <p align="center">
                            <strong>
#if((${sd.getName()} == ${sd.getCountry()}) || (${sd.getClassified()} == ${f}))
                                <font size="5">${sd.getName()}</font>
#else
                                <font size="5">${sd.getName()}, ${sd.getCountry()}</font>
#end
                            </strong>
                        </p>
                    </div>
                    <hr>
                    <div class="contentContainer">
                        <h2 align="center">
#if(${sd.getClassified()} == ${f})
                            <a href="${nc}.html">Non-classified
#else
                            <a href="${ctryFileName}C.html">
                                <img src="${pictures}/${ctryFileName}.gif">
#end
                            </a>
                        </h2>
                    </div>
                </div>
                <div id="userLinks"></div>
                <div id="mainContent">
                    <div class="contentContainer">
                        <h2 align="center">
#if(${sd.getAmount()} == 1)
                            <img src="${pictures}/${sdFileName}${sd.getCounter()}B.jpg">
#elseif(${sd.getAmount()} == 2)
                            <img src="${pictures}/${sdFileName}${sd.getCounter()}v1B.jpg">
                        </h2>
                        <hr style="width: 100%; height: 2px;">
                        <h2 align="center">
                            <img src="${pictures}/${sdFileName}${sd.getCounter()}v2B.jpg">
#end
                        </h2>
                        <div style="text-align: center;">
                            <font size="5">
                                <span style="font-weight: bold;">by
#if(${num} == 0)
                                    <a href="${cbtorFileName}.html">${sd.getBy()}</a>
#else
#foreach($cbtor in ${map.keySet()})
#set($cbtorFileName = ${map.get(${cbtor}).replace(" ","").replace(".","")})
#if($velocityCount != 0)
                                    and
#end
                                    <a href="${cbtorFileName}.html">${cbtor}</a>
#end
#end
                                    <br>
                                    ${sd.getYear()}
                                    <br>
                                </span>
                            </font>
                        </div>
##                        <div style="text-align: right;">
##                            <font size="5">
##                                <span style="font-weight: bold;">
##                                    <a href="${sd.getSite()}">more...</a>
##                                    <br>
##                                </span>
##                            </font>
##                        </div>
                        <br>
                    </div>
                </div>
                <div id="subPageBreaker"></div>
            </div>
            <div id="pageFooter">
                <h6>
                    <div align="center">Copyright © 2006 Lev G. All Rights Reserved.</div>
                </h6>
            </div>
        </div>
    </body>
</html>