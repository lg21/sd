<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="keywords" content=""/>
        <meta name="description" content=""/>
        <meta name="author" content=""/>
        <title>Lev's Snowdomes</title>
        <link rel="stylesheet" type="text/css" href="style.css"/>
    </head>
    <body class="singleLeftPane">
        <div id="pageWrapper">
            <div id="pageHeader">
                <h1>
                    <strong>
                        <font size="5">My Snowdome Collection</font>
                    </strong>
                    <br>
                </h1>
            </div>
            <div id="subPageWrapper">
                <div id="siteNavigation">
                    <h1>Navigation</h1>
                    <ul>
                        <li>
                            <a href="${index}.html">Home</a>
                            <a href="${news}.html">Latest</a>
                            <a href="${all}.html">All</a>
                            <a href="${ctts}.html">By country</a>
                            <a href="${nc}.html">Non-classified</a>
                            <a href="${bl}.html">Blacklist</a>
                        </li>
                    </ul>
                    <div id="listBreaker"></div>
                </div>
                <div id="extraContent">
                    <div class="contentContainer">
                        <div style="text-align: center;">
                            <font size="5">
                                <span style="font-weight: bold;">Contributors</span>
                            </font>
                            <br>
                        </div>
                    </div>
                    <hr>
                    <div class="contentContainer">
                        <p align="center">
                            <img src="${pictures}/${all}B.jpg">
                        </p>
                    </div>
                </div>
                <div id="userLinks"></div>
                <div id="mainContent">
                    <div class="contentContainer">
                        <div style="text-align: center;">
#foreach($sdCbtor in $sdCbtors)
#set($cbtorFileName = ${sdCbtor.getName().replace(" ","").replace(".","")})
#if($velocityCount != 0)
                            <hr>
#end
                            <p align="center">
                                <a href="${cbtorFileName}.html">
                                    <img src="${pictures}/${cbtorFileName}S.jpg">
                                </a>
                            </p>
                            <p align="center">
                                <a href="${cbtorFileName}.html">${sdCbtor.getName()}&nbsp;- ${sdCbtor.getSds().size()}</a>
                            </p>
                            <p align="center"></p>
#end
                        </div>
                    </div>
                </div>
                <div id="subPageBreaker"></div>
            </div>
            <div id="pageFooter">
                <h6>
                    <div align="center">Copyright © 2006 Lev G. All Rights Reserved.</div>
                </h6>
            </div>
        </div>
    </body>
